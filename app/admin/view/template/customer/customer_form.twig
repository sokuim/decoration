<script type="text/javascript"><!--
function country(element, index, zone_id) {
	$.ajax({
		url: 'index.php?route=localisation/country/country&user_token={{ user_token }}&country_id=' + element.value,
		dataType: 'json',
		beforeSend: function() {
			$('select[name=\'address[' + index + '][country_id]\']').prop('disabled', true);
		},
		complete: function() {
			$('select[name=\'address[' + index + '][country_id]\']').prop('disabled', false);
		},
		success: function(json) {
			if (json['postcode_required'] == '1') {
				$('input[name=\'address[' + index + '][postcode]\']').parent().parent().addClass('required');
			} else {
				$('input[name=\'address[' + index + '][postcode]\']').parent().parent().removeClass('required');
			}

			html = '<option value="">{{ text_select }}</option>';

			if (json['zone'] && json['zone'] != '') {
				for (i = 0; i < json['zone'].length; i++) {
					html += '<option value="' + json['zone'][i]['zone_id'] + '"';

					if (json['zone'][i]['zone_id'] == zone_id) {
						html += ' selected="selected"';
					}

					html += '>' + json['zone'][i]['name'] + '</option>';
				}
			} else {
				html += '<option value="0">{{ text_none }}</option>';
			}

			$('select[name=\'address[' + index + '][zone_id]\']').html(html);
            $('select[name=\'address[' + index + '][zone_id]\']').trigger('change');
		},
		error: function(xhr, ajaxOptions, thrownError) {
			alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
		}
	});
}

$('select[name$=\'[country_id]\']').trigger('change');
var showCityOrCountyOptions = function(currentEl, changeEl, isTop, cityId, callback) {
    var zoneId = currentEl.val();
    if (zoneId == null) return;
    var requestUrl = '{{ store_url }}' + 'index.php?route=account/account/zone&zone_id=' + zoneId + '&is_top=' + isTop;
    $.ajax({
        url: requestUrl,
        dataType: 'json',
        beforeSend: function () {
            $('select[name=\'zone_id\']').after('<i class="fa fa-circle-o-notch fa-spin"></i>');
        },
        complete: function () {
            $('.fa-spin').remove();
        },
        success: function (json) {
            html = '<option value="">{{ text_select }}</option>';
            if (json['city'] && json['city'] != '') {
                for (i = 0; i < json['city'].length; i++) {
                    html += '<option value="' + json['city'][i]['city_id'] + '"';
                    if (json['city'][i]['city_id'] == cityId) {
                        html += ' selected="selected"';
                    }
                    html += '>' + json['city'][i]['name'] + '</option>';
                }
            } else {
                html += '<option value="0" selected="selected">{{ text_none }}</option>';
            }
            changeEl.html(html);
            if (typeof(callback) == 'function') {
                callback();
            }
        },
        error: function (xhr, ajaxOptions, thrownError) {
            alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
        }
    });
};

var zone = function(obj, index, cityId) {
    var changeEl = $('#input-city' + index);
    showCityOrCountyOptions($(obj), changeEl, 1, cityId, function () {
        changeEl.trigger('change');
    });
};

var city = function(obj, index, countyId) {
    var changeEl = $('#input-county' + index);
    showCityOrCountyOptions($(obj), changeEl, 0, countyId);
};

// 邮编两段输入：回填拆分 + 拼接 + 自动补全
function splitPostcode(postcode) {
    var digits = (postcode || '').replace(/[^0-9]/g, '');
    return [digits.substring(0, 3), digits.substring(3, 7)];
}

function bindPostcodeAutocomplete(row) {
    var $p1 = $('#input-postcode-1' + row);
    var $p2 = $('#input-postcode-2' + row);
    var $postcode = $('#input-postcode' + row);
    var $btn = $('#button-postcode' + row);

    if ($p1.length == 0 || $p2.length == 0 || $postcode.length == 0) {
        return;
    }

    // 回填拆分
    var parts = splitPostcode($postcode.val());
    if ($p1.val() === '' && parts[0] !== '') {
        $p1.val(parts[0]);
    }
    if ($p2.val() === '' && parts[1] !== '') {
        $p2.val(parts[1]);
    }

    // 输入时只拼接
    var sync = function() {
        var post1 = $p1.val().replace(/[^0-9]/g, '');
        var post2 = $p2.val().replace(/[^0-9]/g, '');
        $postcode.val(post1 + post2);
    };

    $p1.on('input', sync);
    $p2.on('input', sync);

    // 点击按钮触发查询
    $btn.on('click', function() {
        var post1 = $p1.val().replace(/[^0-9]/g, '');
        var post2 = $p2.val().replace(/[^0-9]/g, '');

        if (post1.length !== 3 || post2.length !== 4) {
            alert('{{ entry_postcode }}必填，请输入完整邮编');
            return;
        }

        var postcode = post1 + post2;

        $.ajax({
            url: 'index.php?route=localisation/postcode&user_token={{ user_token }}&postcode=' + postcode,
            dataType: 'json',
            success: function(json) {
                if (json && json.zone_id > 0) {
                    var $zone = $('#input-zone' + row);
                    $zone.val(json.zone_id);

                    var $city = $('#input-city' + row);
                    showCityOrCountyOptions($zone, $city, 1, json.city_id, function () {
                        var $county = $('#input-county' + row);
                        showCityOrCountyOptions($city, $county, 0, json.county_id);
                    });
                }
            }
        });
    });
}

// 页面加载时绑定现有地址
$('input[id^="input-postcode-1"]').each(function() {
    bindPostcodeAutocomplete($(this).attr('id').replace('input-postcode-1', ''));
});

