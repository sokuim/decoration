{{ header }}
<div class="cart-page">
  <div class="subhead">
    <span class="back"></span>
    <div class="ttl">{{ heading_title }}</div>
    <button type="button" class="cart-trash" id="cart-trash" aria-label="{{ text_delete_selected }}"><i class="fa fa-trash-o"></i></button>
  </div>

  {% if attention %}
  <div class="cart-alert">{{ attention }}</div>
  {% endif %}
  {% if success %}
  <div class="cart-alert ok">{{ success }}</div>
  {% endif %}

  <form class="cart-form" action="{{ action }}" method="post" enctype="multipart/form-data" id="cart-form">
    <table class="cart-table" id="product-table">
      <tbody>
      {{ include(helper.template('checkout/cart/_product_list')) }}
      </tbody>
    </table>
  </form>

  <div class="cart-modules" id="accordion">
    {{ include(helper.template('checkout/cart/_module')) }}
  </div>

  <div class="cart-totals-box">
    <table id="cart-totals">
      {{ include(helper.template('checkout/cart/_total')) }}
    </table>
  </div>

  <div class="cart-bar">
    <label class="cart-all"><input type="checkbox" id="checkbox-all" checked="checked" /><span>{{ text_select_all }}</span></label>
    <div class="cart-bar-sum"><span>{{ text_total }}</span><b id="cart-bar-total">{% if totals %}{{ totals|last.text }}{% endif %}</b></div>
    <a href="{{ checkout }}" class="cart-checkout">{{ button_checkout }}</a>
  </div>
</div>

{% if error_warning %}
<script>layer.msg('{{ error_warning }}', {anim: 6});</script>
{% endif %}
<script type="text/javascript"><!--
  var initQuantity;

  $(document).on('focus', '.quantity-wrapper input', function() {
    initQuantity = $(this).val();
  });

  $(document).on('blur', '.quantity-wrapper input', function() {
    if (initQuantity == $(this).val()) return;
    if ($(this).val() < 1) $(this).val(1);
    cart_update();
  });

  $(document).on('click', '#product-table .quantity-wrapper span', function() {
    var _quantity = $(this).siblings('.cart-quantity');

    if ($(this).hasClass('quantity-up')) {
      _quantity.val(parseInt(_quantity.val()) + 1);
    } else {
      if (_quantity.val() <= 1) return;
      _quantity.val(parseInt(_quantity.val()) - 1);
    }

    cart_update();
  });

  $('#checkbox-all').on('change', function() {
    $('#product-table .cart-check-input').prop('checked', $(this).prop('checked'));
  });

  $('#product-table').on('change', '.cart-check-input', function() {
    $('#checkbox-all').prop('checked', $('#product-table .cart-check-input:not(:checked)').length === 0);
  });

  $('#cart-trash').on('click', function() {
    var ids = [];

    $('#product-table .cart-check-input:checked').each(function() {
      ids.push($(this).val());
    });

    if (!ids.length) {
      layer.msg('{{ text_error_select }}');
      return;
    }

    if (!window.confirm('{{ text_confirm_delete }}')) {
      return;
    }

    for (var i = 0; i < ids.length; i++) {
      cart_remove(ids[i]);
    }
  });

  var cart_update = function() {
    $.ajax({
      url: 'index.php?route=checkout/cart/update',
      type: 'post',
      dataType: 'json',
      data: $('#product-table input[name^=\'quantity\']'),
      beforeSend: function() {
        ajax_before();
      },
      success: function(json) {
        ajax_success(json);
      },
      error: function(xhr, ajaxOptions, thrownError) {
        ajax_error();
      }
    });
  };

  function cart_remove(cart_id) {
    $.ajax({
      url: 'index.php?route=checkout/cart/remove',
      type: 'post',
      dataType: 'json',
      data: {key: cart_id},
      beforeSend: function() {
        ajax_before();
      },
      success: function(json) {
        ajax_success(json);
      },
      error: function(xhr, ajaxOptions, thrownError) {
        ajax_error();
      }
    });
  }

  function ajax_before() {
    $('.alert-danger').remove();
    layer.load(2, {shade: [0.4, '#fff']});
  }

  function ajax_error() {
    layer.closeAll();
    layer.msg('{{ error_network }}');
  }

  function ajax_success(json) {
    if (json['redirect']) {
      location = json['redirect'];
      return;
    }

    layer.closeAll();

    if (json['error']) {
      $('.cart-page').prepend('<div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> ' + json['error'] + '<button type="button" class="close" data-dismiss="alert">&times;</button></div>');
    }

    if (json['message']) {
      layer.msg(json['message']);
    }

    if (typeof json['product_list_html'] !== 'undefined') {
      $('#product-table > tbody').html(json['product_list_html']);
    }

    if (typeof json['module_html'] !== 'undefined') {
      $('#accordion').html(json['module_html']);
    }

    if (typeof json['total_html'] !== 'undefined') {
      $('#cart-totals').html(json['total_html']);
    }

    $('#cart').load('index.php?route=common/cart/info');

    $('#checkbox-all').prop('checked', true);

    update_cart_bar_total();
  }

  function update_cart_bar_total() {
    $('#cart-bar-total').text($('#cart-totals tr:last td:last').text());
  }
//--></script>
{{ footer }}
