{{ header }}
<div class="account-page">
  <div class="subhead">
    <span class="back"></span>
    <div class="ttl">{{ heading_title }}</div>
    <span class="act"></span>
  </div>
  {% if success %}
  <div class="account-alert"><i class="fa fa-check-circle"></i> {{ success }}</div>
  {% endif %}
  <div class="account-body">
    <div class="account-info">
      <div class="avatar">{{ lastname|first }}</div>
      <div>
        <b>{{ lastname }} {{ firstname }}<span> {{ text_sama }}</span></b>
        <span class="login-id">{{ text_login_id }}: {{ email }}</span>
      </div>
    </div>

    <div class="account-section">
      <h3>{{ text_my_account }}</h3>
      <ul class="account-links">
        <li><a href="{{ edit }}"><i class="iconfont">&#xe669;</i><span>{{ text_edit }}</span><span class="chev">›</span></a></li>
        <li><a href="{{ password }}"><i class="iconfont">&#xe66c;</i><span>{{ text_password }}</span><span class="chev">›</span></a></li>
        <li><a href="{{ address }}"><i class="iconfont">&#xe66e;</i><span>{{ text_address }}</span><span class="chev">›</span></a></li>
        <li><a href="{{ wishlist }}"><i class="iconfont">&#xe62e;</i><span>{{ text_wishlist }}</span><span class="chev">›</span></a></li>
      </ul>
    </div>

    {% if credit_cards %}
    <div class="account-section">
      <h3>{{ text_credit_card }}</h3>
      <ul class="account-links">
        {% for credit_card in credit_cards %}
        <li><a href="{{ credit_card.href }}"><i class="iconfont">&#xe663;</i><span>{{ credit_card.name }}</span><span class="chev">›</span></a></li>
        {% endfor %}
      </ul>
    </div>
    {% endif %}

    <div class="account-section">
      <h3>{{ text_my_orders }}</h3>
      <ul class="account-links">
        <li><a href="{{ order }}"><i class="iconfont">&#xe634;</i><span>{{ text_order }}</span><span class="chev">›</span></a></li>
        {% if helper.config('config_download_status', 1) %}
        <li><a href="{{ download }}"><i class="iconfont">&#xe640;</i><span>{{ text_download }}</span><span class="chev">›</span></a></li>
        {% endif %}
        {% if reward %}
        <li><a href="{{ reward }}"><i class="iconfont">&#xe619;</i><span>{{ text_reward }}</span><span class="chev">›</span></a></li>
        {% endif %}
        <li><a href="{{ return }}"><i class="iconfont">&#xe604;</i><span>{{ text_return }}</span><span class="chev">›</span></a></li>
        <li><a href="{{ transaction }}"><i class="iconfont">&#xe691;</i><span>{{ text_transaction }}</span><span class="chev">›</span></a></li>
      </ul>
    </div>

    {% if tracking %}
    <div class="account-section">
      <h3>{{ text_my_affiliate }}</h3>
      <ul class="account-links">
        <li><a href="{{ affiliate }}"><i class="iconfont">&#xe635;</i><span>{{ text_affiliate_edit }}</span><span class="chev">›</span></a></li>
        <li><a href="{{ tracking }}"><i class="iconfont">&#xe663;</i><span>{{ text_tracking }}</span><span class="chev">›</span></a></li>
      </ul>
    </div>
    {% endif %}

    <div class="account-section">
      <h3>{{ text_my_newsletter }}</h3>
      <ul class="account-links">
        <li><a href="{{ newsletter }}"><i class="iconfont">&#xe616;</i><span>{{ text_newsletter }}</span><span class="chev">›</span></a></li>
      </ul>
    </div>

    {{ content_top }}
    {{ content_bottom }}
  </div>
</div>
{{ footer }}
