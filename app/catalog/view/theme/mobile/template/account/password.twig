{{ header }}
<div class="account-edit-page">
  <div class="subhead">
    <span class="back"></span>
    <div class="ttl">{{ heading_title }}</div>
    <span class="act"></span>
  </div>
  <div class="account-edit-body">
    <form action="{{ action }}" method="post" enctype="multipart/form-data" class="edit-form">
      <div class="form-card">
        <div class="fields">
          <div class="field">
            <label for="input-password">{{ entry_password }} <span class="req">{{ text_required }}</span></label>
            <input type="password" name="password" value="{{ password }}" placeholder="{{ entry_password }}" id="input-password" class="input" />
            {% if error_password %}<div class="text-danger">{{ error_password }}</div>{% endif %}
          </div>
          <div class="field">
            <label for="input-confirm">{{ entry_confirm }} <span class="req">{{ text_required }}</span></label>
            <input type="password" name="confirm" value="{{ confirm }}" placeholder="{{ entry_confirm }}" id="input-confirm" class="input" />
            {% if error_confirm %}<div class="text-danger">{{ error_confirm }}</div>{% endif %}
          </div>
        </div>
        <button type="submit" class="addr-submit">{{ button_submit }}</button>
        <a href="{{ back }}" class="addr-btn edit-back">{{ button_back }}</a>
      </div>
    </form>
  </div>
</div>
{{ footer }}
