{{ header }}
<div class="article-detail-page">
  <div class="subhead">
    <a class="back" href="{{ continue }}" aria-label="{{ text_article }}">&#8249;</a>
    <div class="ttl">{{ heading_title }}</div>
    <span class="act"></span>
  </div>
  <div class="article-detail-wrap">
    <article class="article-detail-card">
      <div class="article-date">{{ date_added }}</div>
      <div class="article-body">{{ description }}</div>
    </article>
    <a href="{{ continue }}" class="article-back">{{ text_article }}</a>
  </div>
</div>
{{ footer }}
