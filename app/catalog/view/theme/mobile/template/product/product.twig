{{ header }}
<div id="product-product" class="pdp">
  {% if images %}
  <div class="pdp-gallery">
    <a href="javascript:void(0)" class="pdp-back">‹</a>
    <div class="pdp-slides" id="pdp-slides">
      {% if images|length > 1 %}
      {% set last = images|last %}
      <div class="pdp-slide pdp-slide-clone"><img src="{{ last.preview }}" width="{{ preview_width }}" height="{{ preview_height }}" alt="{{ heading_title }}"></div>
      {% endif %}
      {% for image in images %}
      <div class="pdp-slide"><img src="{{ image.preview }}" width="{{ preview_width }}" height="{{ preview_height }}" alt="{{ heading_title }}"></div>
      {% endfor %}
      {% if images|length > 1 %}
      {% set first = images|first %}
      <div class="pdp-slide pdp-slide-clone"><img src="{{ first.preview }}" width="{{ preview_width }}" height="{{ preview_height }}" alt="{{ heading_title }}"></div>
      {% endif %}
    </div>
    <span class="pdp-count"><b id="pdp-index">1</b>/{{ images|length }}</span>
  </div>
  {% endif %}

  <div class="pdp-info">
    <div class="pdp-price-row">
      <div class="pdp-price">
        {% if special %}
        <span class="now">{{ special }}</span><span class="old">{{ price }}</span>
        {% else %}
        <span class="now">{{ price }}</span>
        {% endif %}
        <small>{{ text_tax_included }}</small>
      </div>
      <div class="pdp-stock">{{ text_stock }} <b>{{ stock }}</b></div>
    </div>
    <h1 class="pdp-name">{{ heading_title }}</h1>
    {% if review_status %}
    <div class="pdp-review">
      <span class="stars">
        {% for i in 1..5 %}<i class="fa fa-star{% if rating < i %} off{% endif %}"></i>{% endfor %}
      </span>
      <a href="#pdp-review">{{ reviews }}</a>
    </div>
    {% endif %}
    <div class="pdp-meta">
      {% if manufacturer %}
      <span>{{ text_manufacturer }} <a href="{{ manufacturers }}">{{ manufacturer }}</a></span>
      {% endif %}
    </div>
    {% if tax or discounts or points %}
    <div class="pdp-notes">
      {% if tax %}<div>{{ text_tax }} {{ tax }}</div>{% endif %}
      {% for discount in discounts %}<div>{{ discount.quantity }}{{ text_discount }}{{ discount.price }}</div>{% endfor %}
      {% if points %}<div>{{ text_points }} {{ points }}</div>{% endif %}
    </div>
    {% endif %}
  </div>

  <div class="pdp-section">
    <h2 class="pdp-sec-title">{{ text_product_options }}</h2>
    <div id="product">
      {% include(helper.template('_partial/product/options')) %}
      <div class="pdp-qty">
        <span class="pdp-qty-label">{{ entry_qty }}</span>
        <div class="quantity-input-wrapper">
          <a href="#" class="quantity-down">−</a>
          <input type="text" name="quantity" value="{{ minimum }}" size="2" id="input-quantity" class="form-control" />
          <a href="#" class="quantity-up">＋</a>
          <input type="hidden" name="product_id" value="{{ product_id }}" />
        </div>
      </div>
      {% if minimum > 1 %}
      <div class="pdp-alert"><i class="fa fa-info-circle"></i> {{ text_minimum }}</div>
      {% endif %}
    </div>
  </div>

  {% if model or color or material or accessory or movement or bezel or band or waterproof or feature or hardware or size or weight_value or specification or attribute_groups or shipping_info or return_info %}
  <div class="pdp-section">
    <h2 class="pdp-sec-title">{{ tab_attribute }}</h2>
    {% if model or color or material or accessory or movement or bezel or band or waterproof or feature or hardware or size or weight_value or specification or shipping_info or return_info %}
    <ul class="pdp-attrs">
      {% if shipping_info %}
      <li><span class="pd-attr-label">{{ text_shipping_info }}</span><span class="pd-attr-value">{{ shipping_info }}</span></li>
      {% endif %}
      {% if return_info %}
      <li><span class="pd-attr-label">{{ text_return_info }}</span><span class="pd-attr-value">{{ return_info }}</span></li>
      {% endif %}
      {% if model %}
      <li><span class="pd-attr-label">{{ text_model }}</span><span class="pd-attr-value">{{ model }}</span></li>
      {% endif %}
      {% if material %}
      <li><span class="pd-attr-label">{{ text_material }}</span><span class="pd-attr-value">{{ material }}</span></li>
      {% endif %}
      {% if size %}
      <li><span class="pd-attr-label">{{ text_size }}</span><span class="pd-attr-value">{{ size }}</span></li>
      {% endif %}
      {% if color %}
      <li><span class="pd-attr-label">{{ text_color }}</span><span class="pd-attr-value">{{ color }}</span></li>
      {% endif %}
      {% if hardware %}
      <li><span class="pd-attr-label">{{ text_hardware }}</span><span class="pd-attr-value">{{ hardware }}</span></li>
      {% endif %}
      {% if movement %}
      <li><span class="pd-attr-label">{{ text_movement }}</span><span class="pd-attr-value">{{ movement }}</span></li>
      {% endif %}
      {% if bezel %}
      <li><span class="pd-attr-label">{{ text_bezel }}</span><span class="pd-attr-value">{{ bezel }}</span></li>
      {% endif %}
      {% if band %}
      <li><span class="pd-attr-label">{{ text_band }}</span><span class="pd-attr-value">{{ band }}</span></li>
      {% endif %}
      {% if waterproof %}
      <li><span class="pd-attr-label">{{ text_waterproof }}</span><span class="pd-attr-value">{{ waterproof }}</span></li>
      {% endif %}
      {% if feature %}
      <li><span class="pd-attr-label">{{ text_feature }}</span><span class="pd-attr-value">{{ feature }}</span></li>
      {% endif %}
      {% if specification %}
      <li><span class="pd-attr-label">{{ text_specification }}</span><span class="pd-attr-value">{{ specification }}</span></li>
      {% endif %}
      {% if weight_value %}
      <li><span class="pd-attr-label">{{ text_weight_label }}</span><span class="pd-attr-value">{{ weight_value }}</span></li>
      {% endif %}
      {% if accessory %}
      <li><span class="pd-attr-label">{{ text_accessory }}</span><span class="pd-attr-value">{{ accessory }}</span></li>
      {% endif %}
    </ul>
    {% endif %}
    {% if attribute_groups %}
    <table class="pdp-spec">
      {% for attribute_group in attribute_groups %}
      <tbody>
        <tr class="group"><td colspan="2">{{ attribute_group.name }}</td></tr>
        {% for attribute in attribute_group.attribute %}
        <tr><th>{{ attribute.name }}</th><td>{{ attribute.text }}</td></tr>
        {% endfor %}
      </tbody>
      {% endfor %}
    </table>
    {% endif %}
  </div>
  {% endif %}

  <div class="pdp-section">
    <h2 class="pdp-sec-title">{{ tab_description }}</h2>
    <div class="pdp-desc">{{ description }}</div>
  </div>

  {% if review_status %}
  <div class="pdp-section" id="pdp-review">
    <h2 class="pdp-sec-title">{{ text_review_title }}</h2>
    <form class="pdp-review-form" id="form-review">
      <div id="review"></div>
      {{ include(helper.template('_partial/product/review_form')) }}
    </form>
  </div>
  {% endif %}

  {% if products %}
  <div class="pdp-section">
    <h2 class="pdp-sec-title">{{ text_related }}</h2>
    <div class="row pdp-related">
      {% for product in products %}
      <div class="col-xs-6">
        {{ include(helper.template('_partial/product/product_single')) }}
      </div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  <div class="pdp-bar">
    <button type="button" class="pdp-icon" title="{{ button_wishlist }}" onclick="wishlist.add('{{ product_id }}');"><i class="fa fa-heart-o"></i><span>{{ text_favorite }}</span></button>
    <a class="pdp-icon" href="{{ helper.url.link('checkout/cart') }}"><i class="fa fa-shopping-cart"></i><span>{{ text_cart }}</span></a>
    <button type="button" id="button-cart" class="pdp-cta" data-loading-text="{{ text_loading }}">{{ button_cart }}</button>
    <button type="button" id="button-buy-now" class="pdp-cta buy">{{ text_buy_now }}</button>
  </div>
</div>
<script type="text/javascript"><!--
  jQuery(document).ready(function($) {
    $('.pdp-back').on('click', function() {
      if (history.length > 1) {
        history.back();
      } else {
        location = '{{ helper.url.link('common/home') }}';
      }
    });

    // 图片轮播：首尾各放一张克隆页，实现双向无限滑动
    var slides = document.getElementById('pdp-slides');
    var slideTotal = {{ images|length }};
    var slideTimer = null;

    var updateSlideIndex = function() {
      var width = slides.clientWidth;

      if (!width) {
        return;
      }

      var index = Math.round(slides.scrollLeft / width);

      if (slideTotal > 1) {
        if (index <= 0) {
          slides.scrollLeft = slideTotal * width;
          index = slideTotal;
        } else if (index > slideTotal) {
          slides.scrollLeft = width;
          index = 1;
        }
      }

      $('#pdp-index').text(Math.min(Math.max(index, 1), slideTotal));
    };

    // 初始定位到第一张真实图片（最前面是末图克隆页）
    var initSlides = function() {
      if (slideTotal > 1 && slides.clientWidth) {
        slides.scrollLeft = slides.clientWidth;
      }
    };

    initSlides();
    $(window).on('load', initSlides);

    $('#pdp-slides').on('scroll', function() {
      clearTimeout(slideTimer);
      slideTimer = setTimeout(updateSlideIndex, 120);
    });

    $('#product .quantity-input-wrapper a').click(function(e) {
      e.preventDefault();
      if ($(this).hasClass('quantity-up')) {
        $('#input-quantity').val(parseInt($('#input-quantity').val()) + 1);
      } else {
        if (parseInt($('#input-quantity').val()) > {{ minimum }}) {
          $('#input-quantity').val(parseInt($('#input-quantity').val()) - 1);
        }
      }
    });

    var productData = function() {
      return $('#product input[type=\'text\'], #product input[type=\'hidden\'], #product input[type=\'radio\']:checked, #product input[type=\'checkbox\']:checked, #product select, #product textarea');
    };

    $('#button-cart').productInfoToCart({
      data: [
        '#product input[type=\'text\']',
        '#product input[type=\'hidden\']',
        '#product input[type=\'radio\']:checked',
        '#product input[type=\'checkbox\']:checked',
        '#product select, #product textarea'
      ]
    });

    $('#button-buy-now').on('click', function() {
      $.ajax({
        url: 'index.php?route=checkout/cart/add',
        type: 'post',
        data: productData(),
        dataType: 'json',
        success: function(json) {
          $('.text-danger').remove();

          if (json['error'] && json['error']['option']) {
            for (var i in json['error']['option']) {
              $('#input-option' + i.replace('_', '-')).after('<div class="text-danger">' + json['error']['option'][i] + '</div>');
            }
            return;
          }

          location = '{{ helper.url.link('checkout/checkout') }}';
        }
      });
    });
  });
//--></script>
{{ footer }}
