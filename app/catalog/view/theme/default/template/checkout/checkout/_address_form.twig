{{ header }}
<div class="container">
  <div class="row">
    <div class="col-sm-12">
      <form id="address-form" class="mt-1 mb-1">
        <table class="table table-bordered">
          <tbody>
            <tr>
              <td class="text-right" style="width: 30%;">{{ text_name }} <span class="text-danger">{{ text_required }}</span></td>
              <td>
                <div class="row">
                  <div class="col-sm-6"><input type="text" name="lastname" value="{{ lastname }}" placeholder="{{ placeholder_lastname }}" id="input-lastname" class="form-control" /></div>
                  <div class="col-sm-6"><input type="text" name="firstname" value="{{ firstname }}" placeholder="{{ placeholder_firstname }}" id="input-firstname" class="form-control" /></div>
                </div>
              </td>
            </tr>
            <tr>
              <td class="text-right">{{ text_kana }} <span class="text-danger">{{ text_required }}</span></td>
              <td>
                <div class="row">
                  <div class="col-sm-6"><input type="text" name="lastname_kana" value="{{ lastname_kana }}" placeholder="{{ placeholder_lastname_kana }}" id="input-lastname_kana" class="form-control" /></div>
                  <div class="col-sm-6"><input type="text" name="firstname_kana" value="{{ firstname_kana }}" placeholder="{{ placeholder_firstname_kana }}" id="input-firstname_kana" class="form-control" /></div>
                </div>
              </td>
            </tr>
            <tr>
              <td class="text-right">{{ entry_postcode }} <span class="text-danger">{{ text_required }}</span></td>
              <td>
                <div class="row">
                  <div class="col-xs-3"><input type="text" name="postcode_1" value="{{ postcode_1 }}" placeholder="123" id="input-postcode-1" class="form-control" maxlength="3" required /></div>
                  <div class="col-xs-1 text-center"><span style="line-height:34px;">-</span></div>
                  <div class="col-xs-4"><input type="text" name="postcode_2" value="{{ postcode_2 }}" placeholder="4567" id="input-postcode-2" class="form-control" maxlength="4" required /></div>
                  <div class="col-xs-2"><button type="button" id="button-postcode" class="btn btn-default"><i class="fa fa-search"></i> {{ text_search }}</button></div>
                </div>
                <input type="hidden" name="postcode" value="{{ postcode }}" id="input-postcode" />
              </td>
            </tr>
            <tr>
              <td class="text-right">{{ entry_location }}</td>
              <td>
                <div class="row">
                  <div class="col-sm-3 {{ (not config_select_country) ? 'hidden' }}">
                    <select name="country_id" id="input-country" class="form-control" autocomplete="new-country">
                      <option value="">{{ text_select }}</option>
                      {% for country in countries %}
                        <option value="{{ country.country_id }}" {{ country.country_id == country_id ? 'selected="selected"' }}>{{ country.name }}</option>
                      {% endfor %}
                    </select>
                    {% if error.country %}<div class="text-danger">{{ error.country }}</div>{% endif %}
                  </div>
                  <div class="col-sm-3">
                    <select name="zone_id" id="input-zone" class="form-control"></select>
                    {% if error.zone %}<div class="text-danger">{{ error.zone }}</div>{% endif %}
                  </div>
                  <div class="col-sm-3 hidden">
                    <select name="city_id" id="input-city" class="form-control"></select>
                    {% if error.city %}<div class="text-danger">{{ error.city }}</div>{% endif %}
                  </div>
                  <div class="col-sm-3 hidden">
                    <select name="county_id" id="input-county" class="form-control"></select>
                    {% if error.county %}<div class="text-danger">{{ error.county }}</div>{% endif %}
                  </div>
                  <div class="col-sm-6 hidden">
                    <input type="text" name="city" value="{{ city }}" placeholder="{{ entry_city }}" id="input-city" class="form-control" />
                    {% if error.city %}<div class="text-danger">{{ error.city }}</div>{% endif %}
                  </div>
                </div>
              </td>
            </tr>
            <tr>
              <td class="text-right">{{ entry_address_1 }}</td>
              <td>
                <input type="text" name="address_1" value="{{ address_1 }}" placeholder="{{ entry_address_1 }}" id="input-address-1" class="form-control" />
              </td>
            </tr>
            <tr>
              <td class="text-right">{{ text_telephone }}</td>
              <td>
                <div class="row">
                  <div class="col-xs-3"><input type="text" name="telephone_1" value="{{ telephone_1 }}" placeholder="0X" id="input-telephone-1" class="form-control" maxlength="3" /></div>
                  <div class="col-xs-1 text-center"><span style="line-height:34px;">-</span></div>
                  <div class="col-xs-4"><input type="text" name="telephone_2" value="{{ telephone_2 }}" placeholder="XXXX" id="input-telephone-2" class="form-control" maxlength="4" /></div>
                  <div class="col-xs-1 text-center"><span style="line-height:34px;">-</span></div>
                  <div class="col-xs-3"><input type="text" name="telephone_3" value="{{ telephone_3 }}" placeholder="XXXX" id="input-telephone-3" class="form-control" maxlength="4" /></div>
                </div>
              </td>
            </tr>
            {% for custom_field in custom_fields %}
            {% if custom_field.type == 'select' %}
            <tr data-sort="{{ custom_field.sort_order }}">
              <td class="text-right">{{ custom_field.name }}</td>
              <td>
                <select name="custom_field[{{ custom_field.custom_field_id }}]" id="input-custom-field{{ custom_field.custom_field_id }}" class="form-control">
                  <option value="">{{ text_select }}</option>
                  {% for custom_field_value in custom_field.custom_field_value %}
                  {% set _selected = custom_field_value.custom_field_value_id == address_custom_field[custom_field.custom_field_id] %}
                  <option value="{{ custom_field_value.custom_field_value_id }}" {{ _selected ? 'selected="selected"' }}>
                    {{ custom_field_value.name }}
                  </option>
                  {% endfor %}
                </select>
                {% if error.custom_field[custom_field.custom_field_id] %}
                <div class="text-danger">{{ error.custom_field[custom_field.custom_field_id] }}</div>
                {% endif %}
              </td>
            </tr>
            {% endif %}
            {% if custom_field.type == 'radio' %}
            <tr data-sort="{{ custom_field.sort_order }}">
              <td class="text-right">{{ custom_field.name }}</td>
              <td>
                {% for custom_field_value in custom_field.custom_field_value %}
                {% set _checked = custom_field_value.custom_field_value_id == address_custom_field[custom_field.custom_field_id] %}
                <label class="radio-inline">
                  <input type="radio" name="custom_field[{{ custom_field.custom_field_id }}]" value="{{ custom_field_value.custom_field_value_id }}" {{ _checked ? 'checked="checked"' }} />
                  {{ custom_field_value.name }}
                </label>
                {% endfor %}
                {% if error.custom_field[custom_field.custom_field_id] %}
                <div class="text-danger">{{ error.custom_field[custom_field.custom_field_id] }}</div>
                {% endif %}
              </td>
            </tr>
            {% endif %}
            {% if custom_field.type == 'checkbox' %}
            <tr data-sort="{{ custom_field.sort_order }}">
              <td class="text-right">{{ custom_field.name }}</td>
              <td>
                {% for custom_field_value in custom_field.custom_field_value %}
                {% set _checked = (custom_field_value.custom_field_value_id in address_custom_field[custom_field.custom_field_id]) %}
                <label class="checkbox-inline">
                  <input type="checkbox" name="custom_field[{{ custom_field.custom_field_id }}][]" value="{{ custom_field_value.custom_field_value_id }}" {{ _checked ? 'checked="checked"' }} />
                  {{ custom_field_value.name }}
                </label>
                {% endfor %}
                {% if error.custom_field[custom_field.custom_field_id] %}
                <div class="text-danger">{{ error.custom_field[custom_field.custom_field_id] }}</div>
                {% endif %}
              </td>
            </tr>
            {% endif %}
            {% if custom_field.type == 'text' %}
            <tr data-sort="{{ custom_field.sort_order }}">
              <td class="text-right">{{ custom_field.name }}</td>
              <td>
                <input type="text" name="custom_field[{{ custom_field.custom_field_id }}]" value="{{ address_custom_field[custom_field.custom_field_id] ?: custom_field.value }}" placeholder="{{ custom_field.name }}" id="input-custom-field{{ custom_field.custom_field_id }}" class="form-control" />
                {% if error.custom_field[custom_field.custom_field_id] %}
                <div class="text-danger">{{ error.custom_field[custom_field.custom_field_id] }}</div>
                {% endif %}
              </td>
            </tr>
            {% endif %}
            {% if custom_field.type == 'textarea' %}
            <tr data-sort="{{ custom_field.sort_order }}">
              <td class="text-right">{{ custom_field.name }}</td>
              <td>
                <textarea name="custom_field[{{ custom_field.custom_field_id }}]" rows="5" placeholder="{{ custom_field.name }}" id="input-custom-field{{ custom_field.custom_field_id }}" class="form-control">{{ address_custom_field[custom_field.custom_field_id] ?: custom_field.value }}</textarea>
                {% if error.custom_field[custom_field.custom_field_id] %}
                <div class="text-danger">{{ error.custom_field[custom_field.custom_field_id] }}</div>
                {% endif %}
              </td>
            </tr>
            {% endif %}
            {% if custom_field.type == 'file' %}
            <tr data-sort="{{ custom_field.sort_order }}">
              <td class="text-right">{{ custom_field.name }}</td>
              <td>
                <button type="button" id="button-custom-field{{ custom_field.custom_field_id }}" data-loading-text="{{ text_loading }}" class="btn btn-default">
                  <i class="fa fa-upload"></i> {{ button_upload }}
                </button>
                <a href="{{ helper.handle_custom_file(address_custom_field[custom_field.custom_field_id]) }}" {{ not helper.handle_custom_file(address_custom_field[custom_field.custom_field_id]) ? 'style="display: none;"' }} target="_blank"> &nbsp; <i class="fa fa-eye"></i> {{ text_view }}</a>
                <input type="hidden" name="custom_field[{{ custom_field.custom_field_id }}]" value="{{ address_custom_field[custom_field.custom_field_id] }}" />
                {% if error.custom_field[custom_field.custom_field_id] %}
                <div class="text-danger">{{ error.custom_field[custom_field.custom_field_id] }}</div>
                {% endif %}
              </td>
            </tr>
            {% endif %}
            {% if custom_field.type == 'date' %}
            <tr data-sort="{{ custom_field.sort_order }}">
              <td class="text-right">{{ custom_field.name }}</td>
              <td>
                <div class="input-group date">
                  <input type="text" name="custom_field[{{ custom_field.custom_field_id }}]" value="{{ address_custom_field[custom_field.custom_field_id] ?: custom_field.value }}" placeholder="{{ custom_field.name }}" data-date-format="YYYY-MM-DD" id="input-custom-field{{ custom_field.custom_field_id }}" class="form-control" />
                  <div class="input-group-btn"><button type="button" class="btn btn-default"><i class="fa fa-calendar"></i></button></div>
                </div>
                {% if error.custom_field[custom_field.custom_field_id] %}
                <div class="text-danger">{{ error.custom_field[custom_field.custom_field_id] }}</div>
                {% endif %}
              </td>
            </tr>
            {% endif %}
            {% if custom_field.type == 'time' %}
            <tr data-sort="{{ custom_field.sort_order }}">
              <td class="text-right">{{ custom_field.name }}</td>
              <td>
                <div class="input-group time">
                  <input type="text" name="custom_field[{{ custom_field.custom_field_id }}]" value="{{ address_custom_field[custom_field.custom_field_id] ?: custom_field.value }}" placeholder="{{ custom_field.name }}" data-date-format="HH:mm" id="input-custom-field{{ custom_field.custom_field_id }}" class="form-control" />
                  <div class="input-group-btn"><button type="button" class="btn btn-default"><i class="fa fa-calendar"></i></button></div>
                </div>
                {% if error.custom_field[custom_field.custom_field_id] %}
                <div class="text-danger">{{ error.custom_field[custom_field.custom_field_id] }}</div>
                {% endif %}
              </td>
            </tr>
            {% endif %}
            {% if custom_field.type == 'datetime' %}
            <tr data-sort="{{ custom_field.sort_order }}">
              <td class="text-right">{{ custom_field.name }}</td>
              <td>
                <div class="input-group datetime">
                  <input type="text" name="custom_field[{{ custom_field.custom_field_id }}]" value="{{ address_custom_field[custom_field.custom_field_id] ?: custom_field.value }}" placeholder="{{ custom_field.name }}" data-date-format="YYYY-MM-DD HH:mm" id="input-custom-field{{ custom_field.custom_field_id }}" class="form-control" />
                  <div class="input-group-btn"><button type="button" class="btn btn-default"><i class="fa fa-calendar"></i></button></div>
                </div>
                {% if error.custom_field[custom_field.custom_field_id] %}
                <div class="text-danger">{{ error.custom_field[custom_field.custom_field_id] }}</div>
                {% endif %}
              </td>
            </tr>
            {% endif %}
            {% endfor %}
            <tr>
              <td class="text-right">{{ entry_default }}</td>
              <td>
                <label class="radio-inline">
                  <input type="radio" name="default" value="1" {% if default %}checked="checked"{% endif %} />
                  {{ text_yes }}
                </label>
                <label class="radio-inline">
                  <input type="radio" name="default" value="0" {% if not default %}checked="checked"{% endif %} />
                  {{ text_no }}
                </label>
              </td>
            </tr>
          </tbody>
        </table>
        <button id="button-submit" type="button" data-loading-text="{{ text_loading }}" class="btn btn-primary pull-right">{{ button_submit }}</button>
      </form>
    </div>
  </div>
</div>

<script type="text/javascript"><!--
// Sort the custom fields
$('#address-form tr[data-sort]').detach().each(function() {
  var $tbody = $('#address-form table tbody');
  if ($(this).attr('data-sort') >= 0 && $(this).attr('data-sort') <= $tbody.find('tr').length - 2) {
    $tbody.find('tr').eq(parseInt($(this).attr('data-sort')) + 2).before(this);
  }

  if ($(this).attr('data-sort') > $tbody.find('tr').length - 2) {
    $tbody.find('tr:last').after(this);
  }

  if ($(this).attr('data-sort') == $tbody.find('tr').length - 2) {
    $tbody.find('tr:last').after(this);
  }

  if ($(this).attr('data-sort') < -$tbody.find('tr').length - 2) {
    $tbody.find('tr:first').before(this);
  }
});
//--></script>
<script type="text/javascript"><!--
$('button[id^="button-custom-field"]').on('click', function() {
  var element = this;

  $('#form-upload').remove();

  $('body').prepend('<form enctype="multipart/form-data" id="form-upload" style="display: none;"><input type="file" name="file" /></form>');

  $('#form-upload input[name="file"]').trigger('click');

  if (typeof timer != 'undefined') {
    clearInterval(timer);
  }

  timer = setInterval(function() {
    if ($('#form-upload input[name="file"]').val() != '') {
      clearInterval(timer);

      $.ajax({
        url: 'index.php?route=tool/upload',
        type: 'post',
        dataType: 'json',
        data: new FormData($('#form-upload')[0]),
        cache: false,
        contentType: false,
        processData: false,
        beforeSend: function() {
          $(element).button('loading');
        },
        complete: function() {
          $(element).button('reset');
        },
        success: function(json) {
          $(element).parent().find('.text-danger').remove();

          if (json['error']) {
            $(element).parent().find('input').after('<div class="text-danger">' + json['error'] + '</div>');
          }

          if (json['success']) {
            layer.msg(json['success']);

            $(element).parent().find('input').val(json['code']);
            $(element).siblings('a').show().prop('href',json['link']);
          }
        },
        error: function(xhr, ajaxOptions, thrownError) {
          alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
        }
      });
    }
  }, 500);
});
//--></script>
<script type="text/javascript"><!--
$('.date').datetimepicker({
  language: '{{ datepicker }}',
  pickTime: false
});

$('.datetime').datetimepicker({
  language: '{{ datepicker }}',
  pickDate: true,
  pickTime: true
});

$('.time').datetimepicker({
  language: '{{ datepicker }}',
  pickDate: false
});
//--></script>
<script type="text/javascript"><!--
$('select[name="country_id"]').on('change', function() {
  $.ajax({
    url: 'index.php?route=account/account/country&country_id=' + this.value,
    dataType: 'json',
    beforeSend: function() {
      $('select[name="country_id"] .text-danger').remove();
      $('select[name="country_id"]').prop('disabled', true);
      $('select[name="city_id"]').parent().addClass('hidden');
      $('select[name="county_id"]').parent().addClass('hidden');
      $('input[name="city"]').parent().addClass('hidden');
    },
    complete: function() {
      //
    },
    success: function(json) {
      $('select[name="country_id"]').prop('disabled', false);

      if (json['postcode_required'] == '1') {
        $('input[name="postcode"]').closest('tr').addClass('required');
      } else {
        $('input[name="postcode"]').closest('tr').removeClass('required');
      }

      html = '<option value="">{{ text_select }}</option>';

      if (json['zone'] && json['zone'] != '') {
        for (i = 0; i < json['zone'].length; i++) {
          html += '<option value="' + json['zone'][i]['zone_id'] + '"';

          if (json['zone'][i]['zone_id'] == '{{ zone_id }}') {
            html += ' selected="selected"';
          }

          html += '>' + json['zone'][i]['name'] + '</option>';
        }
      }

      $('select[name="zone_id"]').html(html);
      $('select[name="city_id"]').html('');
      $('select[name="county_id"]').html('');

      if ($('select[name="zone_id"] option:selected').val() > 0) {
        $('select[name="zone_id"]').trigger('change');
      }
    },
    error: function(xhr, ajaxOptions, thrownError) {
      $('select[name="country_id"]').after('<div class="text-danger">' + xhr.responseText + '</div>');
    }
  });
});

$('select[name="country_id"]').trigger('change');

var showCityOrCountyOptions = function(currentEl, changeEl, isTop, cityId, callback) {
  var zoneId = currentEl.val();
  if (zoneId == null) return;
  var requestUrl = 'index.php?route=account/account/zone&zone_id=' + zoneId + '&is_top=' + isTop;
  $.ajax({
    url: requestUrl,
    dataType: 'json',
    beforeSend: function () {
      currentEl.prop('disabled', true);
      changeEl.prop('disabled', true);
    },
    complete: function () {
      //
    },
    success: function (json) {
      currentEl.prop('disabled', false);
      changeEl.prop('disabled', false);

      html = '<option value="">{{ text_select }}</option>';
      if (json['city'] && json['city'] != '') {
        for (i = 0; i < json['city'].length; i++) {
          html += '<option value="' + json['city'][i]['city_id'] + '"';
          if (json['city'][i]['city_id'] == cityId) {
            html += ' selected="selected"';
          }
          html += '>' + json['city'][i]['name'] + '</option>';
        }
      }
      changeEl.html(html);
      if (typeof(callback) == 'function') {
        callback();
      }
    },
    error: function (xhr, ajaxOptions, thrownError) {
      alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
    }
  });
};

$('select[name="zone_id"]').bind('change', function() {
  $('select[name="city_id"]').parent().addClass('hidden');
  $('select[name="city_id"]').html('');
  $('select[name="county_id"]').parent().addClass('hidden');
  $('select[name="county_id"]').html('');
  $('input[name="city"]').parent().addClass('hidden');
  var changeEl = $('select[name="city_id"]');
  var cityId = '{{ city_id  }}';
  showCityOrCountyOptions($(this), changeEl, 1, cityId, function() {
    if ($('select[name="city_id"] option').length > 1) {
      $('select[name="city_id"]').parent().removeClass('hidden');
      if ($('select[name="city_id"] option:selected').val() > 0) {
        changeEl.trigger('change');
      }
    } else {
      $('input[name="city"]').parent().removeClass('hidden');
    }
  });
});

$('select[name="city_id"]').bind('change', function() {
  $('select[name="county_id"]').parent().addClass('hidden');
  $('select[name="county_id"]').html('');
  var changeEl = $('select[name="county_id"]');
  var countyId = '{{ county_id }}';
  showCityOrCountyOptions($(this), changeEl, 0, countyId, function() {
    if ($('select[name="county_id"] option').length > 1) {
      $('select[name="county_id"]').parent().removeClass('hidden');
    }
  });
});
//--></script>
<script type="text/javascript"><!--
$('#button-submit').on('click', function () {
  $.ajax({
    url: 'index.php?route=checkout/checkout/save_address&type={{ type }}&address_id=' + {{ address_id ?: 0 }},
    type: 'post',
    data: $('#address-form input[type="text"],#address-form input[type="hidden"], #address-form input[type="date"], #address-form input[type="datetime"], #address-form input[type="time"], #address-form input[type="password"], #address-form input[type="checkbox"]:checked, #address-form input[type="radio"]:checked, #address-form textarea, #address-form select'),
    dataType: 'json',
    beforeSend: function() {
      $('#address-form tr').removeClass('has-error');
      $('#address-form .alert-danger').remove();
      $('#address-form .help-block').remove();
      $('#button-submit').button('loading');
    },
    success: function(json) {
      if (json['redirect']) {
        location = json['redirect'];
        return;
      }

      if (json['error']) {
        $('#button-submit').button('reset');
        $.each(json['error'], function (key, value) {
          if (key.indexOf('custom_field') === 0) {
            var control = $('#address-form [name^="custom_field[' + key.replace('custom_field_', '') + ']"]').first();
          } else {
            var control = $('#address-form [name="' + key + '"]').first();
          }

          control.closest('tr').addClass('has-error');
          control.closest('td').append('<span class="help-block">' + value + '</span>');
        });

        if (json['error']['warning']) {
          $('#address-form').append('<div class="alert alert-danger">' + json['error']['warning'] + '</div>')
        }

        return;
      }

      // Address saved, close current window
      var index = parent.layer.getFrameIndex(window.name);
      parent.layer.close(index);
    },
    error: function(xhr, ajaxOptions, thrownError) {
    }
  });
});
//--></script>
<script type="text/javascript"><!--
// 邮编两段输入：回填拆分 + 拼接 + 查询补全
function splitPostcode(postcode) {
  var digits = (postcode || '').replace(/[^0-9]/g, '');
  return [digits.substring(0, 3), digits.substring(3, 7)];
}

function bindPostcodeAutocomplete() {
  var $p1 = $('input[name="postcode_1"]');
  var $p2 = $('input[name="postcode_2"]');
  var $postcode = $('input[name="postcode"]');
  var $btn = $('#button-postcode');

  if ($p1.length == 0 || $p2.length == 0 || $postcode.length == 0) {
    return;
  }

  var parts = splitPostcode($postcode.val());
  if ($p1.val() === '' && parts[0] !== '') {
    $p1.val(parts[0]);
  }
  if ($p2.val() === '' && parts[1] !== '') {
    $p2.val(parts[1]);
  }

  var sync = function() {
    var post1 = $p1.val().replace(/[^0-9]/g, '');
    var post2 = $p2.val().replace(/[^0-9]/g, '');
    $postcode.val(post1 + post2);
  };

  $p1.on('input', sync);
  $p2.on('input', sync);

  $btn.on('click', function() {
    var post1 = $p1.val().replace(/[^0-9]/g, '');
    var post2 = $p2.val().replace(/[^0-9]/g, '');

    if (post1.length !== 3 || post2.length !== 4) {
      alert('{{ text_postcode_required }}');
      return;
    }

    var postcode = post1 + post2;

    $.ajax({
      url: 'index.php?route=account/account/postcode&postcode=' + postcode,
      dataType: 'json',
      success: function(json) {
        if (json && json.zone_id > 0) {
          var $zone = $('select[name="zone_id"]');
          var $city = $('select[name="city_id"]');
          var $county = $('select[name="county_id"]');

          $zone.val(json.zone_id);
          $city.parent().removeClass('hidden');
          $county.parent().removeClass('hidden');
          $('input[name="city"]').parent().addClass('hidden');

          showCityOrCountyOptions($zone, $city, 1, json.city_id, function() {
            showCityOrCountyOptions($city, $county, 0, json.county_id, function() {
              $county.parent().removeClass('hidden');
            });
          });
        }
      }
    });
  });
}

$(document).ready(function() {
  bindPostcodeAutocomplete();
});
