{% if not modal %}
<footer>
  <div class="wrap">
    <div class="foot-top">
      <div class="foot-brand">
        <div class="logo"><img src="{{ transparent_logo ? transparent_logo : logo }}" alt="{{ name }}" /></div>
        {% if footer_description %}<p>{{ footer_description }}</p>{% endif %}
      </div>
      <div class="foot-col">
        <h4>{{ text_shopping_guide }}</h4>
        {% for information in informations %}<a href="{{ information.href }}">{{ information.title }}</a>{% endfor %}
      </div>
      <div class="foot-col">
        <h4>{{ text_about }}</h4>
        <a href="{{ contact }}">{{ text_contact }}</a>
        <a href="{{ sitemap }}">{{ text_sitemap }}</a>
        <a href="{{ manufacturer }}">{{ text_manufacturer }}</a>
        <a href="{{ special }}">{{ text_special }}</a>
        <a href="{{ article }}">{{ text_article }}</a>
      </div>
      <div class="foot-col">
        <h4>{{ text_support }}</h4>
        <a href="{{ contact }}">{{ text_contact_us }}</a>
        <a href="{{ tracking }}">{{ text_track_order }}</a>
        <a href="{{ helper.url.link('account/register') }}">{{ text_register }}</a>
        <a href="{{ helper.url.link('account/login') }}">{{ text_login }}</a>
      </div>
    </div>
    <div class="foot-bottom"><span>© 2026 {{ name }}</span><span>{{ text_tagline }}</span></div>
  </div>
</footer>
{% endif %}
{% for script in scripts %}
<script src="{{ script }}" type="text/javascript"></script>
{% endfor %}

<script type="text/javascript">
  var redirectButtonText = '';
  var redirectButtonLocation = '';

  var showAlert = function(type, content) {
    if (type == 'cart') {
      redirectButtonText = '{{ button_checkout }}';
      redirectButtonLocation = '{{ helper.url.link("checkout/cart") }}';
    } else if (type == 'wishlist') {
      redirectButtonText = '{{ button_wishlist }}';
      redirectButtonLocation = '{{ wishlist }}';
    } else if (type == 'compare') {
      redirectButtonText = '{{ button_compare }}';
      redirectButtonLocation = '{{ helper.url.link("product/compare") }}';
    }

    layer.open({
      title: '{{ text_layer_popup_title }}',
      skin: 'layer-alert',
      shadeClose: true,
      content: content,
      btn: [redirectButtonText, '{{ button_continue_shopping }}'],
      yes: function() {
        location = redirectButtonLocation;
      }
    });
  }
</script>
<script type="text/javascript">
// 懒加载图片：占位效果作用于图片容器，不修改 img 自身属性
(function() {
  var containers = '.image, .collect-grid-thumb, .collect-product-thumb, .collect-categories a, .article-cat-thumb, .article-cat-media, .cart-panel-thumb, .collect-cat-image, .image-additional, .csi-img, .compare-image';
  var images = document.querySelectorAll('img[loading="lazy"]');

  for (var i = 0; i < images.length; i++) {
    (function(image) {
      var box = image.closest ? image.closest(containers) : null;

      if (!box) {
        return;
      }

      if (image.complete && image.naturalWidth > 0) {
        return;
      }

      box.classList.add('lazy-loading');

      var loaded = function() {
        box.classList.remove('lazy-loading');
      };

      image.addEventListener('load', loaded);
      image.addEventListener('error', loaded);

      // 防止加载完成发生在绑定事件之前
      if (image.complete) {
        loaded();
      }
    })(images[i]);
  }
})();

// 超链接悬停/聚焦时保持原有文字颜色
function collectLinkColor(link) {
  link.style.setProperty('--link-color', window.getComputedStyle(link).color);
}

function collectLinkColors(root) {
  var links = (root || document).querySelectorAll('a');

  for (var i = 0; i < links.length; i++) {
    collectLinkColor(links[i]);
  }
}

document.addEventListener('DOMContentLoaded', function() {
  collectLinkColors(document);
});

// 覆盖后续动态插入的链接（弹层、购物车刷新等）
if (window.MutationObserver) {
  new MutationObserver(function(mutations) {
    for (var i = 0; i < mutations.length; i++) {
      var nodes = mutations[i].addedNodes;

      for (var j = 0; j < nodes.length; j++) {
        if (nodes[j].nodeType !== 1) {
          continue;
        }

        if (nodes[j].tagName === 'A') {
          collectLinkColor(nodes[j]);
        }

        collectLinkColors(nodes[j]);
      }
    }
  }).observe(document.documentElement, {childList: true, subtree: true});
}
</script>
{{ helper.debug_bar.render }}
</body></html>
