{{ header }}
<div class="container">
  <div class="row">
    <div id="content" class="col-sm-12">{{ content_top }}
      <div class="login-page">
        <a class="logo login-logo" href="{{ helper.url.link('common/home') }}"><img src="{{ transparent_logo ? transparent_logo : logo }}" alt="{{ helper.config('config_name') }}" /></a>
        <div class="form-card login-card">
          {% if error_warning %}
          <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}</div>
          {% endif %}
          <p class="forgot-text">{{ text_email }}</p>
          <form action="{{ action }}" method="post" enctype="multipart/form-data">
            <div class="field">
              <label for="input-email">{{ entry_email }}</label>
              <input type="text" name="email" value="{{ email }}" placeholder="{{ entry_email }}" id="input-email" class="input" />
            </div>
            <button type="submit" class="addr-submit">{{ button_submit }}</button>
            <div class="login-divider"></div>
            <a href="{{ back }}" class="addr-btn login-register">{{ button_back }}</a>
          </form>
        </div>
      </div>
      {{ content_bottom }}
    </div>
  </div>
</div>
{{ footer }}
