{{ header }}
<div id="account-address" class="container">
  {{ include(helper.template('_partial/breadcrumb')) }}
  <div class="row">{{ column_left }}
    {% if column_left and column_right %}
    {% set class = 'col-sm-6' %}
    {% elseif column_left or column_right %}
    {% set class = 'col-sm-9' %}
    {% else %}
    {% set class = 'col-sm-12' %}
    {% endif %}
    <div id="content" class="{{ class }}">{{ content_top }}
      <div class="form-card">
        <h4>{{ text_address }}</h4>
      <form action="{{ action }}" method="post" enctype="multipart/form-data">
        <table class="addr-form">
          <tbody>
            <tr>
              <th>{{ text_name }} <span class="req">{{ text_required_mark }}</span></th>
              <td>
                <div class="row2">
                  <input type="text" name="lastname" value="{{ lastname }}" placeholder="{{ placeholder_lastname }}" id="input-lastname" class="input" />
                  <input type="text" name="firstname" value="{{ firstname }}" placeholder="{{ placeholder_firstname }}" id="input-firstname" class="input" />
                </div>
                {% if error_lastname %}<div class="text-danger">{{ error_lastname }}</div>{% endif %}
                {% if error_firstname %}<div class="text-danger">{{ error_firstname }}</div>{% endif %}
              </td>
            </tr>
            <tr>
              <th>{{ text_kana }} <span class="req">{{ text_required_mark }}</span></th>
              <td>
                <div class="row2">
                  <input type="text" name="lastname_kana" value="{{ lastname_kana }}" placeholder="{{ placeholder_lastname_kana }}" id="input-lastname_kana" class="input" />
                  <input type="text" name="firstname_kana" value="{{ firstname_kana }}" placeholder="{{ placeholder_firstname_kana }}" id="input-firstname_kana" class="input" />
                </div>
                {% if error_lastname_kana %}<div class="text-danger">{{ error_lastname_kana }}</div>{% endif %}
                {% if error_firstname_kana %}<div class="text-danger">{{ error_firstname_kana }}</div>{% endif %}
              </td>
            </tr>
            <tr>
              <th>{{ entry_postcode }} <span class="req">{{ text_required_mark }}</span></th>
              <td>
                <div class="segs">
                  <input type="text" name="postcode_1" value="{{ postcode_1 }}" placeholder="123" id="input-postcode-1" class="input" maxlength="3" required />
                  <span class="sep">−</span>
                  <input type="text" name="postcode_2" value="{{ postcode_2 }}" placeholder="4567" id="input-postcode-2" class="input" maxlength="4" required />
                  <button type="button" id="button-postcode" class="addr-btn">{{ text_search }}</button>
                </div>
                <input type="hidden" name="postcode" value="{{ postcode }}" id="input-postcode" />
                {% if error_postcode %}<div class="text-danger">{{ error_postcode }}</div>{% endif %}
              </td>
            </tr>
            <tr>
              <th>{{ entry_location }}</th>
              <td>
                <div class="region">
                  <div class="{{ (not config_select_country) ? 'hidden' }}">
                    <select name="country_id" id="input-country-id" class="select" autocomplete="new-country-id">
                      <option value="">{{ text_select }}</option>
                      {% for country in countries %}
                        <option value="{{ country.country_id }}" {{ country.country_id == country_id ? 'selected="selected"' }}>{{ country.name }}</option>
                      {% endfor %}
                    </select>
                    {% if error.country %}<div class="text-danger">{{ error.country }}</div>{% endif %}
                  </div>
                  <div>
                    <select name="zone_id" id="input-zone-id" class="select"></select>
                    {% if error.zone %}<div class="text-danger">{{ error.zone }}</div>{% endif %}
                  </div>
                  <div>
                    <select name="city_id" id="input-city-id" class="select"></select>
                    {% if error.city %}<div class="text-danger">{{ error.city }}</div>{% endif %}
                  </div>
                  <div>
                    <select name="county_id" id="input-county-id" class="select"></select>
                    {% if error.county %}<div class="text-danger">{{ error.county }}</div>{% endif %}
                  </div>
                  <div class="hidden">
                    <input type="text" name="city" value="{{ city }}" placeholder="{{ entry_city }}" id="input-city" class="input" />
                    {% if error.city %}<div class="text-danger">{{ error.city }}</div>{% endif %}
                  </div>
                </div>
              </td>
            </tr>
            <tr>
              <th>{{ entry_address_1 }}</th>
              <td>
                <input type="text" name="address_1" value="{{ address_1 }}" placeholder="{{ entry_address_1 }}" id="input-address-1" class="input" />
                {% if error_address_1 %}<div class="text-danger">{{ error_address_1 }}</div>{% endif %}
              </td>
            </tr>
            <tr>
              <th>{{ text_telephone }}</th>
              <td>
                <div class="segs">
                  <input type="text" name="telephone_1" value="{{ telephone_1 }}" placeholder="0X" id="input-telephone-1" class="input" maxlength="3" />
                  <span class="sep">−</span>
                  <input type="text" name="telephone_2" value="{{ telephone_2 }}" placeholder="XXXX" id="input-telephone-2" class="input" maxlength="4" />
                  <span class="sep">−</span>
                  <input type="text" name="telephone_3" value="{{ telephone_3 }}" placeholder="XXXX" id="input-telephone-3" class="input" maxlength="4" />
                </div>
                {% if error_telephone %}<div class="text-danger">{{ error_telephone }}</div>{% endif %}
              </td>
            </tr>
            {% for custom_field in custom_fields %}
            {% if custom_field.type == 'select' %}
            <tr data-sort="{{ custom_field.sort_order }}">
              <th>{{ custom_field.name }}</th>
              <td>
                <select name="custom_field[{{ custom_field.location }}][{{ custom_field.custom_field_id }}]" id="input-custom-field{{ custom_field.custom_field_id }}" class="form-control">
                  <option value="">{{ text_select }}</option>
                  {% for custom_field_value in custom_field.custom_field_value %}
                  {% if address_custom_field[custom_field.custom_field_id] and custom_field_value.custom_field_value_id == address_custom_field[custom_field.custom_field_id] %}
                  <option value="{{ custom_field_value.custom_field_value_id }}" selected="selected">{{ custom_field_value.name }}</option>
                  {% else %}
                  <option value="{{ custom_field_value.custom_field_value_id }}">{{ custom_field_value.name }}</option>
                  {% endif %}
                  {% endfor %}
                </select>
                {% if error_custom_field[custom_field.custom_field_id] %}<div class="text-danger">{{ error_custom_field[custom_field.custom_field_id] }}</div>{% endif %}
              </td>
            </tr>
            {% endif %}
            {% if custom_field.type == 'radio' %}
            <tr data-sort="{{ custom_field.sort_order }}">
              <th>{{ custom_field.name }}</th>
              <td>
                {% for custom_field_value in custom_field.custom_field_value %}
                <label class="radio-inline">
                  {% if address_custom_field[custom_field.custom_field_id] and custom_field_value.custom_field_value_id == address_custom_field[custom_field.custom_field_id] %}
                  <input type="radio" name="custom_field[{{ custom_field.location }}][{{ custom_field.custom_field_id }}]" value="{{ custom_field_value.custom_field_value_id }}" checked="checked" />
                  {% else %}
                  <input type="radio" name="custom_field[{{ custom_field.location }}][{{ custom_field.custom_field_id }}]" value="{{ custom_field_value.custom_field_value_id }}" />
                  {% endif %}
                  {{ custom_field_value.name }}
                </label>
                {% endfor %}
                {% if error_custom_field[custom_field.custom_field_id] %}<div class="text-danger">{{ error_custom_field[custom_field.custom_field_id] }}</div>{% endif %}
              </td>
            </tr>
            {% endif %}
            {% if custom_field.type == 'checkbox' %}
            <tr data-sort="{{ custom_field.sort_order }}">
              <th>{{ custom_field.name }}</th>
              <td>
                {% for custom_field_value in custom_field.custom_field_value %}
                <label class="checkbox-inline">
                  {% if address_custom_field[custom_field.custom_field_id] and custom_field_value.custom_field_value_id in address_custom_field[custom_field.custom_field_id] %}
                  <input type="checkbox" name="custom_field[{{ custom_field.location }}][{{ custom_field.custom_field_id }}][]" value="{{ custom_field_value.custom_field_value_id }}" checked="checked" />
                  {% else %}
                  <input type="checkbox" name="custom_field[{{ custom_field.location }}][{{ custom_field.custom_field_id }}][]" value="{{ custom_field_value.custom_field_value_id }}" />
                  {% endif %}
                  {{ custom_field_value.name }}
                </label>
                {% endfor %}
                {% if error_custom_field[custom_field.custom_field_id] %}<div class="text-danger">{{ error_custom_field[custom_field.custom_field_id] }}</div>{% endif %}
              </td>
            </tr>
            {% endif %}
            {% if custom_field.type == 'text' %}
            <tr data-sort="{{ custom_field.sort_order }}">
              <th>{{ custom_field.name }}</th>
              <td>
                <input type="text" name="custom_field[{{ custom_field.location }}][{{ custom_field.custom_field_id }}]" value="{% if address_custom_field[custom_field.custom_field_id] %}{{ address_custom_field[custom_field.custom_field_id] }}{% else %}{{ custom_field.value }}{% endif %}" placeholder="{{ custom_field.name }}" id="input-custom-field{{ custom_field.custom_field_id }}" class="form-control" />
                {% if error_custom_field[custom_field.custom_field_id] %}<div class="text-danger">{{ error_custom_field[custom_field.custom_field_id] }}</div>{% endif %}
              </td>
            </tr>
            {% endif %}
            {% if custom_field.type == 'textarea' %}
            <tr data-sort="{{ custom_field.sort_order }}">
              <th>{{ custom_field.name }}</th>
              <td>
                <textarea name="custom_field[{{ custom_field.location }}][{{ custom_field.custom_field_id }}]" rows="5" placeholder="{{ custom_field.name }}" id="input-custom-field{{ custom_field.custom_field_id }}" class="form-control">{% if address_custom_field[custom_field.custom_field_id] %}{{ address_custom_field[custom_field.custom_field_id] }}{% else %}{{ custom_field.value }}{% endif %}</textarea>
                {% if error_custom_field[custom_field.custom_field_id] %}<div class="text-danger">{{ error_custom_field[custom_field.custom_field_id] }}</div>{% endif %}
              </td>
            </tr>
            {% endif %}
            {% if custom_field.type == 'file' %}
            <tr data-sort="{{ custom_field.sort_order }}">
              <th>{{ custom_field.name }}</th>
              <td>
                <button type="button" id="button-custom-field{{ custom_field.custom_field_id }}" data-loading-text="{{ text_loading }}" class="btn btn-default"><i class="fa fa-upload"></i> {{ button_upload }}</button>
                <input type="hidden" name="custom_field[{{ custom_field.location }}][{{ custom_field.custom_field_id }}]" value="{% if address_custom_field[custom_field.custom_field_id] %}  {{ address_custom_field[custom_field.custom_field_id] }} {% endif %}" />
                {% if error_custom_field[custom_field.custom_field_id] %}<div class="text-danger">{{ error_custom_field[custom_field.custom_field_id] }}</div>{% endif %}
              </td>
            </tr>
            {% endif %}
            {% if custom_field.type == 'date' %}
            <tr data-sort="{{ custom_field.sort_order }}">
              <th>{{ custom_field.name }}</th>
              <td>
                <div class="input-group date">
                  <input type="text" name="custom_field[{{ custom_field.location }}][{{ custom_field.custom_field_id }}]" value="{% if address_custom_field[custom_field.custom_field_id] %}{{ address_custom_field[custom_field.custom_field_id] }}{% else %}{{ custom_field.value }}{% endif %}" placeholder="{{ custom_field.name }}" data-date-format="YYYY-MM-DD" id="input-custom-field{{ custom_field.custom_field_id }}" class="form-control" />
                  <div class="input-group-btn"><button type="button" class="btn btn-default"><i class="fa fa-calendar"></i></button></div>
                </div>
                {% if error_custom_field[custom_field.custom_field_id] %}<div class="text-danger">{{ error_custom_field[custom_field.custom_field_id] }}</div>{% endif %}
              </td>
            </tr>
            {% endif %}
            {% if custom_field.type == 'time' %}
            <tr data-sort="{{ custom_field.sort_order }}">
              <th>{{ custom_field.name }}</th>
              <td>
                <div class="input-group time">
                  <input type="text" name="custom_field[{{ custom_field.location }}][{{ custom_field.custom_field_id }}]" value="{% if address_custom_field[custom_field.custom_field_id] %}{{ address_custom_field[custom_field.custom_field_id] }}{% else %}{{ custom_field.value }}{% endif %}" placeholder="{{ custom_field.name }}" data-date-format="HH:mm" id="input-custom-field{{ custom_field.custom_field_id }}" class="form-control" />
                  <div class="input-group-btn"><button type="button" class="btn btn-default"><i class="fa fa-calendar"></i></button></div>
                </div>
                {% if error_custom_field[custom_field.custom_field_id] %}<div class="text-danger">{{ error_custom_field[custom_field.custom_field_id] }}</div>{% endif %}
              </td>
            </tr>
            {% endif %}
            {% if custom_field.type == 'datetime' %}
            <tr data-sort="{{ custom_field.sort_order }}">
              <th>{{ custom_field.name }}</th>
              <td>
                <div class="input-group datetime">
                  <input type="text" name="custom_field[{{ custom_field.location }}][{{ custom_field.custom_field_id }}]" value="{% if address_custom_field[custom_field.custom_field_id] %}{{ address_custom_field[custom_field.custom_field_id] }}{% else %}{{ custom_field.value }}{% endif %}" placeholder="{{ custom_field.name }}" data-date-format="YYYY-MM-DD HH:mm" id="input-custom-field{{ custom_field.custom_field_id }}" class="form-control" />
                  <div class="input-group-btn"><button type="button" class="btn btn-default"><i class="fa fa-calendar"></i></button></div>
                </div>
                {% if error_custom_field[custom_field.custom_field_id] %}<div class="text-danger">{{ error_custom_field[custom_field.custom_field_id] }}</div>{% endif %}
              </td>
            </tr>
            {% endif %}
            {% endfor %}
            <tr>
              <th>{{ entry_default }}</th>
              <td>
                {% if default %}
                <label class="radio-inline"><input type="radio" name="default" value="1" checked="checked" /> {{ text_yes }}</label>
                <label class="radio-inline"><input type="radio" name="default" value="0" /> {{ text_no }}</label>
                {% else %}
                <label class="radio-inline"><input type="radio" name="default" value="1" /> {{ text_yes }}</label>
                <label class="radio-inline"><input type="radio" name="default" value="0" checked="checked" /> {{ text_no }}</label>
                {% endif %}
              </td>
            </tr>
          </tbody>
        </table>
        <div class="buttons addr-buttons">
          <input type="submit" value="{{ button_submit }}" class="addr-submit" />
          <a href="{{ back }}" class="addr-btn addr-back">{{ button_back }}</a>
        </div>
      </form>
      </div>
      {{ content_bottom }}</div>
    {{ column_right }}</div>
</div>
<script type="text/javascript"><!--
// Sort the custom fields
$('tr[data-sort]').detach().each(function() {
  var $tbody = $('form table tbody');
  if ($(this).attr('data-sort') >= 0 && $(this).attr('data-sort') <= $tbody.find('tr').length - 2) {
    $tbody.find('tr').eq(parseInt($(this).attr('data-sort')) + 2).before(this);
  }

  if ($(this).attr('data-sort') > $tbody.find('tr').length - 2) {
    $tbody.find('tr:last').after(this);
  }

  if ($(this).attr('data-sort') == $tbody.find('tr').length - 2) {
    $tbody.find('tr:last').after(this);
  }

  if ($(this).attr('data-sort') < -$tbody.find('tr').length - 2) {
    $tbody.find('tr:first').before(this);
  }
});
//--></script>
<script type="text/javascript"><!--
$('button[id^="button-custom-field"]').on('click', function() {
  var element = this;

  $('#form-upload').remove();

  $('body').prepend('<form enctype="multipart/form-data" id="form-upload" style="display: none;"><input type="file" name="file" /></form>');

  $('#form-upload input[name="file"]').trigger('click');

  if (typeof timer != 'undefined') {
    clearInterval(timer);
  }

  timer = setInterval(function() {
    if ($('#form-upload input[name="file"]').val() != '') {
      clearInterval(timer);

      $.ajax({
        url: 'index.php?route=tool/upload',
        type: 'post',
        dataType: 'json',
        data: new FormData($('#form-upload')[0]),
        cache: false,
        contentType: false,
        processData: false,
        beforeSend: function() {
          $(element).button('loading');
        },
        complete: function() {
          $(element).button('reset');
        },
        success: function(json) {
          $(element).parent().find('.text-danger').remove();

          if (json['error']) {
            $(element).parent().find('input').after('<div class="text-danger">' + json['error'] + '</div>');
          }

          if (json['success']) {
            alert(json['success']);

            $(element).parent().find('input').val(json['code']);
          }
        },
        error: function(xhr, ajaxOptions, thrownError) {
          alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
        }
      });
    }
  }, 500);
});
//--></script>
<script type="text/javascript"><!--
$('.date').datetimepicker({
  language: '{{ datepicker }}',
  pickTime: false
});

$('.datetime').datetimepicker({
  language: '{{ datepicker }}',
  pickDate: true,
  pickTime: true
});

$('.time').datetimepicker({
  language: '{{ datepicker }}',
  pickDate: false
});
//--></script>
<script type="text/javascript"><!--
$('select[name="country_id"]').on('change', function() {
  $.ajax({
    url: 'index.php?route=account/account/country&country_id=' + this.value,
    dataType: 'json',
    beforeSend: function() {
      $('select[name="country_id"] .text-danger').remove();
      $('select[name="country_id"]').prop('disabled', true);
    },
    complete: function() {
      //
    },
    success: function(json) {
      $('select[name="country_id"]').prop('disabled', false);

      if (json['postcode_required'] == '1') {
        $('input[name="postcode"]').closest('tr').addClass('required');
      } else {
        $('input[name="postcode"]').closest('tr').removeClass('required');
      }

      html = '<option value="">{{ text_select }}</option>';

      if (json['zone'] && json['zone'] != '') {
        for (i = 0; i < json['zone'].length; i++) {
          html += '<option value="' + json['zone'][i]['zone_id'] + '"';

          if (json['zone'][i]['zone_id'] == '{{ zone_id }}') {
            html += ' selected="selected"';
          }

          html += '>' + json['zone'][i]['name'] + '</option>';
        }
      }

      $('select[name="zone_id"]').html(html);
      $('select[name="city_id"]').html('');
      $('select[name="county_id"]').html('');

      if ($('select[name="zone_id"] option:selected').val() > 0) {
        $('select[name="zone_id"]').trigger('change');
      }
    },
    error: function(xhr, ajaxOptions, thrownError) {
      $('select[name="country_id"]').after('<div class="text-danger">' + xhr.responseText + '</div>');
    }
  });
});

$('select[name="country_id"]').trigger('change');

var showCityOrCountyOptions = function(currentEl, changeEl, isTop, cityId, callback) {
  var zoneId = currentEl.val();
  if (zoneId == null) return;
  var requestUrl = 'index.php?route=account/account/zone&zone_id=' + zoneId + '&is_top=' + isTop;
  $.ajax({
    url: requestUrl,
    dataType: 'json',
    beforeSend: function () {
      currentEl.prop('disabled', true);
      changeEl.prop('disabled', true);
    },
    complete: function () {
      //
    },
    success: function (json) {
      currentEl.prop('disabled', false);
      changeEl.prop('disabled', false);

      html = '<option value="">{{ text_select }}</option>';
      if (json['city'] && json['city'] != '') {
        for (i = 0; i < json['city'].length; i++) {
          html += '<option value="' + json['city'][i]['city_id'] + '"';
          if (json['city'][i]['city_id'] == cityId) {
            html += ' selected="selected"';
          }
          html += '>' + json['city'][i]['name'] + '</option>';
        }
      }
      changeEl.html(html);
      if (typeof(callback) == 'function') {
        callback();
      }
    },
    error: function (xhr, ajaxOptions, thrownError) {
      alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
    }
  });
};

$('select[name="zone_id"]').bind('change', function() {
  var changeEl = $('select[name="city_id"]');
  var cityId = '{{ city_id  }}';
  showCityOrCountyOptions($(this), changeEl, 1, cityId, function() {
    if ($('select[name="city_id"] option:selected').val() > 0) {
      changeEl.trigger('change');
    }
  });
});

$('select[name="city_id"]').bind('change', function() {
  var changeEl = $('select[name="county_id"]');
  var countyId = '{{ county_id }}';
  showCityOrCountyOptions($(this), changeEl, 0, countyId, function() {
  });
});
//--></script>
<script type="text/javascript"><!--
// 邮编两段输入：回填拆分 + 拼接 + 查询补全
function splitPostcode(postcode) {
  var digits = (postcode || '').replace(/[^0-9]/g, '');
  return [digits.substring(0, 3), digits.substring(3, 7)];
}

function bindPostcodeAutocomplete() {
  var $p1 = $('input[name="postcode_1"]');
  var $p2 = $('input[name="postcode_2"]');
  var $postcode = $('input[name="postcode"]');
  var $btn = $('#button-postcode');

  if ($p1.length == 0 || $p2.length == 0 || $postcode.length == 0) {
    return;
  }

  // 回填拆分
  var parts = splitPostcode($postcode.val());
  if ($p1.val() === '' && parts[0] !== '') {
    $p1.val(parts[0]);
  }
  if ($p2.val() === '' && parts[1] !== '') {
    $p2.val(parts[1]);
  }

  // 输入时只拼接
  var sync = function() {
    var post1 = $p1.val().replace(/[^0-9]/g, '');
    var post2 = $p2.val().replace(/[^0-9]/g, '');
    $postcode.val(post1 + post2);
  };

  $p1.on('input', sync);
  $p2.on('input', sync);

  // 点击查询按钮
  $btn.on('click', function() {
    var post1 = $p1.val().replace(/[^0-9]/g, '');
    var post2 = $p2.val().replace(/[^0-9]/g, '');

    if (post1.length !== 3 || post2.length !== 4) {
      alert('{{ text_postcode_required }}');
      return;
    }

    var postcode = post1 + post2;

    $.ajax({
      url: 'index.php?route=account/account/postcode&postcode=' + postcode,
      dataType: 'json',
      success: function(json) {
        if (json && json.zone_id > 0) {
          var $zone = $('select[name="zone_id"]');
          var $city = $('select[name="city_id"]');
          var $county = $('select[name="county_id"]');

          $zone.val(json.zone_id);
          $city.parent().removeClass('hidden');
          $county.parent().removeClass('hidden');
          $('input[name="city"]').parent().addClass('hidden');

          showCityOrCountyOptions($zone, $city, 1, json.city_id, function() {
            showCityOrCountyOptions($city, $county, 0, json.county_id, function() {
              $county.parent().removeClass('hidden');
            });
          });
        }
      }
    });
  });
}

$(document).ready(function() {
  bindPostcodeAutocomplete();
});
//--></script>
{{ footer }}
