{% if blocks %}
<section aria-labelledby="heading-block-{{ module }}" class="block-section">
  {% if module_title %}<div class="section-header"><h2 id="heading-block-{{ module }}" class="block-module-title">{{ module_title }}</h2></div>{% endif %}
  <ul class="block-grid" style="display:grid;grid-template-columns:repeat(7,1fr);gap:30px;list-style:none;margin:0;padding:0;">
    {% for block in blocks %}
    <li style="box-sizing:border-box;padding:18px 8px;border:1px solid #E9E4DB;border-radius:6px;text-align:center;background-color:{{ block.background_color }};">
      {% if block.link %}<a href="{{ block.link }}" title="{{ block.title }}" style="display:block;color:inherit;text-decoration:none;">{% endif %}
        {% if block.image %}<img src="{{ block.image }}" alt="{{ block.title ? block.title : helper.config('config_name') ~ '（くらしマート）オンラインショップ' }}" loading="lazy" decoding="async" style="display:block;width:38%;aspect-ratio:1/1;object-fit:cover;border-radius:6px;margin:0 auto;" />{% endif %}
        {% if block.title %}<span class="block-title" style="margin-top:10px;display:block;">{{ block.title }}</span>{% endif %}
      {% if block.link %}</a>{% endif %}
    </li>
    {% endfor %}
  </ul>
</section>
{% endif %}
