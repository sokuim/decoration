<div class="filter">
  <h4>{{ heading_title }}</h4>
  {% for filter_group in filter_groups %}
  <div class="group">
    <div class="lab">{{ filter_group.name }}</div>
    {% for filter in filter_group.filter %}
    <label><input type="checkbox" name="filter[]" value="{{ filter.filter_id }}" {% if filter.filter_id in filter_category %}checked="checked"{% endif %} /> {{ filter.name }}</label>
    {% endfor %}
  </div>
  {% endfor %}
  <button type="button" id="button-filter" class="btn o sm" style="width:100%;margin-top:8px">{{ button_filter }}</button>
</div>
<script type="text/javascript"><!--
$('#button-filter').on('click', function() {
	filter = [];

	$('input[name^=\'filter\']:checked').each(function(element) {
		filter.push(this.value);
	});

	location = '{{ action }}&filter=' + filter.join(',');
});
//--></script>
